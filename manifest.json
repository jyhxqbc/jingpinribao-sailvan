{
  "manifest_version": 3,
  "name": "精品日报",
  "version": "3.5.1",
  "description": "147 精品日报：本地 Amazon 经营分析、增量导入、层级透视、广告图表与 ASIN 聚合链接。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["unlimitedStorage"],
  "action": {
    "default_title": "打开精品日报",
    "default_icon": {
      "16": "icons/147-16.png",
      "32": "icons/147-32.png",
      "48": "icons/147-48.png",
      "128": "icons/147-128.png"
    }
  },
  "icons": {
    "16": "icons/147-16.png",
    "32": "icons/147-32.png",
    "48": "icons/147-48.png",
    "128": "icons/147-128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self';"
  }
}
